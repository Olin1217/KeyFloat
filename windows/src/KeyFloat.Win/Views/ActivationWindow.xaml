<Window x:Class="KeyFloat.Win.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyFloat" Width="460" Height="468" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Topmost="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="16" Background="#171717" BorderBrush="#454545" BorderThickness="1"
            MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
        <Grid>
            <Grid Margin="22,16,22,20">
                <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Source='Assets/KeyFloat White Logo.png', Converter={StaticResource IconPath}}"
                               Width="30" Height="30" Stretch="Uniform" />
                        <TextBlock Text="KeyFloat" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LanguageButton" Style="{StaticResource PlainButton}" Height="30" Padding="5,0"
                                Foreground="#A9A9A9" Click="Language_Click" />
                        <Button Style="{StaticResource PlainButton}" Width="30" Height="30" Margin="3,0,0,0"
                                Background="#242424" BorderBrush="#3C3C3C" BorderThickness="1" Click="Quit_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#B5B5B5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,36,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="28" />
                        <RowDefinition Height="46" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="46" /><RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="32" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="SubtitleText" Grid.Row="1" FontSize="14" Foreground="#AFAFAF" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Border Grid.Row="3" Background="#0F0F0F" BorderBrush="#494949" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBox x:Name="CodeTextBox" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="White"
                                     Margin="12,0" VerticalContentAlignment="Center" TextChanged="CodeTextBox_TextChanged" AutomationProperties.Name="Activation voucher" />
                            <TextBlock x:Name="PlaceholderText" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#6F6F6F"
                                       Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="HelperText" Grid.Row="4" FontSize="11.5" Foreground="#818181" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock x:Name="ErrorText" Grid.Row="5" FontSize="12" FontWeight="Medium" Foreground="#D6D6D6"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                    <Button x:Name="ActivateButton" Grid.Row="7" Style="{StaticResource PlainButton}"
                            Background="White" Foreground="Black" FontSize="13.5" FontWeight="SemiBold" Click="Activate_Click" AutomationProperties.Name="Activate KeyFloat" />
                    <Button x:Name="ContactButton" Grid.Row="8" Style="{StaticResource PlainButton}" Foreground="#AFAFAF"
                            FontSize="14" Click="Contact_Click" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <Grid x:Name="ContactOverlay" Visibility="Collapsed" Background="#101010" MouseLeftButtonDown="ContactBackdrop_MouseLeftButtonDown">
                <Border x:Name="ContactCard" Width="340" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1C1C1C" BorderBrush="#4C4C4C" BorderThickness="1" CornerRadius="14"
                        MouseLeftButtonDown="ContactCard_MouseLeftButtonDown">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="White">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="EmailTitleText" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock x:Name="ReplyTimeText" FontSize="11.5" Foreground="#969696" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#3B3B3B" Margin="0,17" />
                        <Border Height="44" CornerRadius="8" Background="#111111" BorderBrush="#3F3F3F" BorderThickness="1" Padding="14,0,7,0">
                            <Grid>
                                <TextBlock Text="SHL7450702@gmail.com" FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <Button Style="{StaticResource PlainButton}" Width="30" Height="30" HorizontalAlignment="Right"
                                        Background="#242424" BorderBrush="#3C3C3C" BorderThickness="1" Click="CopyEmail_Click">
                                    <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#B5B5B5" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
