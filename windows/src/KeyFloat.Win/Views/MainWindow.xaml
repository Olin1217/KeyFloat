<Window x:Class="KeyFloat.Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KeyFloat.Core.Models;assembly=KeyFloat.Core"
        xmlns:controls="clr-namespace:KeyFloat.Win.Controls"
        Title="KeyFloat" Width="230" Height="62"
        MinWidth="230" MinHeight="62" MaxWidth="230" MaxHeight="62"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" SnapsToDevicePixels="True"
        UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown" SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_PlacementChanged" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <DataTemplate x:Key="SoftwareLogoTemplate" DataType="{x:Type core:SoftwarePack}">
            <Border Width="34" Height="34" CornerRadius="10.5"
                    Background="{Binding Id, Converter={StaticResource IconBackground}}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Image Source="{Binding IconPath, Converter={StaticResource IconPath}}"
                       Margin="{Binding Id, Converter={StaticResource IconInset}}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="controls:ButtonAssist.CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PanelBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerCardStyle" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Width" Value="178" />
            <Setter Property="Height" Value="59" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="controls:ButtonAssist.CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder" CornerRadius="15" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid x:Name="CollapsedPanel" Background="{DynamicResource PanelBrush}"
                  MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="73" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="7" Height="17" HorizontalAlignment="Right" Margin="0,0,7,0">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    <Ellipse Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    <Ellipse Grid.Row="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    <Ellipse Grid.Row="2" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding SelectedSoftware}" ContentTemplate="{StaticResource SoftwareLogoTemplate}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSoftware.Name}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CompanionText}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleExpansionCommand}"
                            ToolTip="{Binding ExpansionToolTip}" AutomationProperties.Name="{Binding ExpansionToolTip}">
                        <TextBlock Text="{Binding ExpansionGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" Margin="3,0,0,0"
                            ToolTip="{Binding CloseToolTip}" AutomationProperties.Name="{Binding CloseToolTip}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="101" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource ChromeBrush}" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="31" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="172" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="7" Height="17" HorizontalAlignment="Right" Margin="0,0,7,0">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Ellipse Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Grid.Row="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Grid.Row="2" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <Button x:Name="SoftwareSelector" Grid.Column="1" Style="{StaticResource PlainButton}"
                            HorizontalContentAlignment="Left" Click="SoftwareSelector_Click" AutomationProperties.Name="{Binding ChooseSoftwareText}">
                        <Grid Width="145" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding SelectedSoftware}" ContentTemplate="{StaticResource SoftwareLogoTemplate}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSoftware.Name}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LibraryText}" FontSize="9.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SoftwareChevron" Grid.Column="3" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToolTip}" AutomationProperties.Name="{Binding ThemeToolTip}">
                            <TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding TogglePinCommand}" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}" Margin="3,0,0,0">
                            <TextBlock Text="{Binding PinGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleLanguageCommand}" AutomationProperties.Name="Language" Margin="3,0,0,0">
                            <TextBlock Text="{Binding LanguageButtonText}" FontSize="10.5" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleExpansionCommand}" ToolTip="{Binding ExpansionToolTip}" AutomationProperties.Name="{Binding ExpansionToolTip}" Margin="3,0,0,0">
                            <TextBlock Text="{Binding ExpansionGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="{Binding CloseToolTip}" AutomationProperties.Name="{Binding CloseToolTip}" Margin="3,0,0,0">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" Grid.ColumnSpan="4" />
                </Grid>

                <Grid Grid.Row="1" Background="{DynamicResource ChromeBrush}" Margin="0">
                    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="45" /></Grid.RowDefinitions>
                    <Border x:Name="SearchBorder" Grid.Row="0" Height="36" Margin="13,10,13,10" CornerRadius="11"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchTextBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11.5" VerticalContentAlignment="Center" Padding="0"
                                     ToolTip="{Binding SearchPlaceholder}" GotKeyboardFocus="SearchTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchTextBox_LostKeyboardFocus" AutomationProperties.Name="{Binding SearchPlaceholder}" />
                            <TextBlock Grid.Column="1" Text="{Binding SearchPlaceholder}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Query, Converter={StaticResource EmptyStringVisibility}}" />
                            <Border Grid.Column="2" Style="{StaticResource KeyCapBorder}" Height="16" MinWidth="38" Padding="4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" FontFamily="Cascadia Mono, Consolas" FontSize="8"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="13,0,13,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PlainButton}" Command="{Binding SetFavoriteFilterCommand}" CommandParameter="False"
                                            controls:ButtonAssist.CornerRadius="6" Height="25" Padding="9,0" Background="{Binding AllFilterActive, Converter={StaticResource FilterBackground}}"
                                            Foreground="{Binding AllFilterActive, Converter={StaticResource FilterForeground}}">
                                        <TextBlock Text="{Binding AllText}" FontSize="9.5" />
                                    </Button>
                                    <Button Style="{StaticResource PlainButton}" Command="{Binding SetFavoriteFilterCommand}" CommandParameter="True"
                                            controls:ButtonAssist.CornerRadius="6" Height="25" Padding="9,0" Margin="2,0,0,0"
                                            Background="{Binding FavoriteFilterActive, Converter={StaticResource FilterBackground}}"
                                            Foreground="{Binding FavoriteFilterActive, Converter={StaticResource FilterForeground}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FavoritesText}" FontSize="9.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Height="25" Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Margin="0,0,5,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding PlatformText}" FontSize="9.5" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="13,0">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <TextBlock Text="{Binding Title}" FontSize="10" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Background="{DynamicResource ContentBrush}" Margin="16,0">
                    <TextBlock Text="{Binding ResultTitle}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShownCountText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="4" Background="{DynamicResource ContentBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,10"
                                  Visibility="{Binding FilteredSections.Count, Converter={StaticResource PositiveCountVisibility}}">
                        <ItemsControl ItemsSource="{Binding FilteredSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="28" Background="{DynamicResource ContentBrush}">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,0" />
                                            <TextBlock Text="{Binding Title}" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="41" CornerRadius="10" Background="{DynamicResource ContentBrush}" Padding="10,0,7,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="27" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,3,0">
                                                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Grid.Column="2" Style="{StaticResource PlainButton}" Width="22" Height="22"
                                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                                                <TextBlock Text="{Binding FavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding FilteredSections.Count, Converter={StaticResource ZeroCountVisibility}}">
                        <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EmptyMessage}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" MaxWidth="250" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" Background="{DynamicResource ChromeBrush}">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource KeyCapBorder}" Height="16" MinWidth="24" Padding="4,0" CornerRadius="4">
                            <TextBlock Text="Esc" FontFamily="Cascadia Mono, Consolas" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding CollapseText}" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,5,0" />
                        <TextBlock Text="·" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <Border Style="{StaticResource KeyCapBorder}" Height="16" MinWidth="35" Padding="4,0" CornerRadius="4" Margin="5,0,0,0">
                            <TextBlock Text="Ctrl K" FontFamily="Cascadia Mono, Consolas" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding SearchText}" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button Style="{StaticResource PlainButton}" Command="{Binding OpenFeedbackCommand}" Margin="0,0,13,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding FeedbackText}" FontSize="8.5" />
                            </StackPanel>
                        </Button>
                        <Image Source="{Binding Source='Assets/KeyFloat Logo.png', Converter={StaticResource IconPath}}" Width="12" Height="12" />
                        <TextBlock Text="KeyFloat" FontSize="8.5" FontWeight="SemiBold" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Popup x:Name="SoftwarePopup" PlacementTarget="{Binding ElementName=SoftwareSelector}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                   Opened="SoftwarePopup_Opened" Closed="SoftwarePopup_Closed">
                <Border Width="396" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="15" SnapsToDevicePixels="True"
                        PreviewMouseDown="SoftwarePopupContent_PreviewMouseDown">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="86" /><RowDefinition Height="1" /><RowDefinition Height="470" /><RowDefinition Height="1" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,12">
                            <StackPanel Orientation="Horizontal" Height="18">
                                <TextBlock Text="{Binding ChooseSoftwareText}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SwitchLibraryText}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource PlainButton}" Command="{Binding ActivateSoftwareSearchCommand}"
                                    Visibility="{Binding IsSoftwareSearchActive, Converter={StaticResource InverseBoolVisibility}}"
                                    Height="34" controls:ButtonAssist.CornerRadius="10" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch">
                                <Grid Margin="10,0">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SoftwareSearchPlaceholder}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="18,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border x:Name="SoftwareSearchBorder" Height="34" Tag="10" Margin="0,10,0,0" CornerRadius="10"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding IsSoftwareSearchActive, Converter={StaticResource BoolVisibility}}">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="SoftwareSearchTextBox" Grid.Column="1" Text="{Binding SoftwarePickerQuery, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="10.5" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding SoftwareSearchPlaceholder}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SoftwareSearchPlaceholder}" FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding SoftwarePickerQuery, Converter={StaticResource EmptyStringVisibility}}" />
                                    <Button Grid.Column="2" Style="{StaticResource PlainButton}" Command="{Binding ClearSoftwareSearchCommand}"
                                            Visibility="{Binding HasSoftwarePickerQuery, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PickerSections}" Margin="11">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal" Margin="3,0,0,7">
                                                <TextBlock Text="{Binding Title}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Count}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="7,1,0,0" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource PickerCardStyle}" IsEnabled="{Binding IsEnabled}" Click="PickerEntry_Click">
                                                            <Grid>
                                                                <TextBlock Text="+" FontSize="23" FontWeight="Light" Foreground="{DynamicResource BorderBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsAdd, Converter={StaticResource BoolVisibility}}" />
                                                                <Grid Visibility="{Binding IsSoftware, Converter={StaticResource BoolVisibility}}">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <ContentControl Content="{Binding Software}" ContentTemplate="{StaticResource SoftwareLogoTemplate}" />
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Software.Name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="4" Text="{Binding PickerFooterText}"
                                   FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Popup>

            <Border x:Name="ToastBorder" Visibility="Collapsed" Height="32" Padding="12,0" CornerRadius="10"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,47">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0" />
                    <TextBlock x:Name="ToastText" FontSize="10.5" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
