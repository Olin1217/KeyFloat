<Window x:Class="KeyFloat.Win.Views.SubmissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyFloat.Win.Controls"
        Width="380" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="15" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,3,12,0" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="Close_Click" HorizontalAlignment="Right">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
            </Grid>

            <TextBlock x:Name="MainLabel" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,7" />
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11,8">
                <Grid>
                    <TextBox x:Name="MainTextBox" FontSize="10.5" MinHeight="38" MaxHeight="92"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="MainTextBox_TextChanged" />
                    <TextBlock x:Name="MainPlaceholder" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" IsHitTestVisible="False" Margin="1,2,1,0" />
                </Grid>
            </Border>

            <TextBlock x:Name="ContactLabel" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,7" />
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11,8">
                <Grid>
                    <TextBox x:Name="ContactTextBox" FontSize="10.5" MinHeight="42" MaxHeight="58"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="ContactTextBox_TextChanged" />
                    <TextBlock x:Name="ContactPlaceholder" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" IsHitTestVisible="False" Margin="1,2,1,0" />
                </Grid>
            </Border>

            <Button x:Name="SubmitButton" Style="{StaticResource PlainButton}" Height="38" controls:ButtonAssist.CornerRadius="10"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource PanelBrush}"
                    FontSize="11" FontWeight="SemiBold" Margin="0,16,0,0" Click="Submit_Click" IsEnabled="False" />
        </StackPanel>
    </Border>
</Window>
