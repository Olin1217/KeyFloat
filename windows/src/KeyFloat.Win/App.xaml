<Application x:Class="KeyFloat.Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KeyFloat.Win.Converters"
             xmlns:controls="clr-namespace:KeyFloat.Win.Controls">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141414" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="ContentBrush" Color="#0F0F0F" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#282828" />
        <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#363636" />
        <SolidColorBrush x:Key="BorderBrush" Color="#414141" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F4" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEAEAE" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7C7C7C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D0D0D0" />

        <converters:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <converters:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />
        <converters:PositiveCountToVisibilityConverter x:Key="PositiveCountVisibility" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringVisibility" />
        <converters:FilterBackgroundConverter x:Key="FilterBackground" />
        <converters:FilterForegroundConverter x:Key="FilterForeground" />
        <converters:IconPathConverter x:Key="IconPath" />
        <converters:SoftwareIconInsetConverter x:Key="IconInset" />
        <converters:SoftwareIconBackgroundConverter x:Key="IconBackground" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="controls:ButtonAssist.CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding controls:ButtonAssist.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="controls:ButtonAssist.CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="KeyCapBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="21" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Application.Resources>
</Application>
