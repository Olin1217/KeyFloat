KEYFLOAT_CHECKOUT_ENABLED=false
KEYFLOAT_LICENSE_PRIVATE_KEY_BASE64=generate-with-npm-run-generate-license-key
# Keep false until short-code-capable macOS and Windows installers are live.
KEYFLOAT_SHORT_CODES_ENABLED=false
# Maximum number of distinct local installations that may redeem one short code.
KEYFLOAT_LICENSE_DEVICE_LIMIT=3

# Automatic Alipay face-to-face QR checkout. Keep disabled until every value
# below is configured and the Alipay application has the required product.
KEYFLOAT_ALIPAY_ENABLED=false
# The application App ID shown in the Alipay Open Platform console.
KEYFLOAT_ALIPAY_APP_ID=replace-with-your-alipay-app-id
# Base64 of the complete RSA2 PKCS#8 merchant private-key PEM. This is your
# application private key and must never be sent to the browser or committed.
KEYFLOAT_ALIPAY_PRIVATE_KEY_BASE64=base64-of-complete-merchant-private-key-pem
# Base64 of the complete Alipay RSA2 public-key PEM shown by the platform.
# This is the Alipay public key, not your application's public key.
KEYFLOAT_ALIPAY_PUBLIC_KEY_BASE64=base64-of-complete-alipay-public-key-pem
# Optional but recommended extra merchant-identity check.
KEYFLOAT_ALIPAY_SELLER_ID=replace-with-your-2088-seller-id
KEYFLOAT_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# Public HTTPS origin without a path. The callback defaults to
# https://your-domain/api/alipay/notify.
KEYFLOAT_PUBLIC_BASE_URL=https://keyfloat.cn
# Optional explicit override when the callback uses a different public URL.
# KEYFLOAT_ALIPAY_NOTIFY_URL=https://keyfloat.cn/api/alipay/notify
KEYFLOAT_ALIPAY_SUBJECT=KeyFloat activation code
KEYFLOAT_ALIPAY_TIMEOUT_EXPRESS=30m

# Optional release overrides. The checked-in release manifest remains the
# default; set these only when publishing an emergency replacement build.
KEYFLOAT_MACOS_LATEST_VERSION=1.0.4
KEYFLOAT_MACOS_DOWNLOAD_URL=https://keyfloat.cn/downloads/KeyFloat-macOS-1.0.4-universal.dmg
KEYFLOAT_WINDOWS_LATEST_VERSION=1.0.5
KEYFLOAT_WINDOWS_DOWNLOAD_URL=https://keyfloat.cn/downloads/KeyFloat-Windows-1.0.5-x64-Setup.exe

# Optional private HTTPS installer URL returned only after manual approval.
KEYFLOAT_INSTALLER_DOWNLOAD_URL=https://downloads.example.com/keyfloat.dmg

# Authentication session and verification-code secrets. Use two independent
# values of at least 32 random characters in production.
KEYFLOAT_SESSION_SECRET=replace-with-a-long-random-session-secret
KEYFLOAT_AUTH_CODE_SECRET=replace-with-a-different-long-random-code-secret

# Private administrator access. Configure these only in the deployment
# environment; never place the real code in site-config.js or app.js.
KEYFLOAT_ADMIN_LOGIN_CODE=replace-with-your-private-admin-code
KEYFLOAT_ADMIN_EMAIL=admin@example.com

# Production persistence through Vercel KV or Upstash Redis REST.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-your-private-rest-token
# Single-server alternative to Redis. The systemd service already grants
# write access to /var/lib/keyfloat-web.
# KEYFLOAT_DATA_FILE=/var/lib/keyfloat-web/store.json

# Choose "smtp", "resend", or "webhook" in production for login codes and
# voucher delivery. Local development defaults to console simulation.
KEYFLOAT_AUTH_EMAIL_PROVIDER=smtp
KEYFLOAT_AUTH_FROM_EMAIL=KeyFloat <login@notice.keyfloat.cn>

# Alibaba Cloud Direct Mail SMTP. Keep the real authorization password only in
# a private local environment file and the server environment file.
KEYFLOAT_SMTP_HOST=smtpdm.aliyun.com
KEYFLOAT_SMTP_PORT=465
KEYFLOAT_SMTP_SECURE=true
KEYFLOAT_SMTP_USER=login@notice.keyfloat.cn
KEYFLOAT_SMTP_PASSWORD=replace-with-your-private-smtp-authorization-password

# Alternative Resend adapter:
# KEYFLOAT_AUTH_EMAIL_PROVIDER=resend
# KEYFLOAT_AUTH_FROM_EMAIL=KeyFloat <login@your-verified-domain.com>
# RESEND_API_KEY=re_replace-with-your-resend-api-key

# Alternative webhook adapter:
# KEYFLOAT_AUTH_EMAIL_PROVIDER=webhook
# KEYFLOAT_AUTH_EMAIL_WEBHOOK_URL=https://mail.example.com/keyfloat/send-code
# KEYFLOAT_AUTH_EMAIL_WEBHOOK_TOKEN=replace-with-a-long-random-token
