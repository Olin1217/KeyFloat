[Unit]
Description=KeyFloat website and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keyfloat
Group=keyfloat
WorkingDirectory=/opt/keyfloat-web/current
EnvironmentFile=/etc/keyfloat-web.env
ExecStart=/usr/bin/node scripts/dev-server.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/keyfloat-web
UMask=0077

[Install]
WantedBy=multi-user.target
